{
  "entities": {
    "Branch": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Branch",
      "type": "object",
      "description": "Represents a branch of the microfinance organization.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the Branch entity." },
        "name": { "type": "string", "description": "Name of the branch." },
        "areaId": { "type": "string", "description": "Reference to Area. (Relationship: Area 1:N Branch)" },
        "address": { "type": "string", "description": "Physical address of the branch." },
        "contactNumber": { "type": "string", "description": "Contact phone number of the branch." }
      },
      "required": ["id", "name", "areaId", "address", "contactNumber"]
    },
    "Area": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Area",
      "type": "object",
      "description": "Represents an area within the microfinance organization's hierarchy.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the Area entity." },
        "name": { "type": "string", "description": "Name of the area." },
        "zoneId": { "type": "string", "description": "Reference to Zone. (Relationship: Zone 1:N Area)" }
      },
      "required": ["id", "name", "zoneId"]
    },
    "Zone": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Zone",
      "type": "object",
      "description": "Represents a zone within the microfinance organization's hierarchy.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the Zone entity." },
        "name": { "type": "string", "description": "Name of the zone." },
        "regionId": { "type": "string", "description": "Reference to Region. (Relationship: Region 1:N Zone)" }
      },
      "required": ["id", "name", "regionId"]
    },
    "Region": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Region",
      "type": "object",
      "description": "Represents a region within the microfinance organization's hierarchy.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the Region entity." },
        "name": { "type": "string", "description": "Name of the region." }
      },
      "required": ["id", "name"]
    },
    "Employee": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Employee",
      "type": "object",
      "description": "Represents an employee of the microfinance organization, linked to a Firebase Auth user.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the Employee Firestore document." },
        "uid": { "type": "string", "description": "The UID of the corresponding Firebase Authentication user." },
        "name": { "type": "string", "description": "Full name of the employee." },
        "bengaliName": { "type": "string", "description": "Full name of the employee in Bengali." },
        "email": { "type": "string", "format": "email", "description": "The login email for the employee. Must be unique." },
        "code": { "type": "string", "description": "The employee's unique code." },
        "role": { "type": "string", "enum": ["Branch User", "Area User", "Zonal User", "Regional User", "Head Office", "Super Admin"], "description": "The assigned role of the employee." },
        "assignment": { "type": "string", "description": "The ID of the Region, Zone, Area, or Branch the employee is assigned to. For Head Office/Super Admin, this is 'Head Office'." }
      },
      "required": ["id", "uid", "name", "email", "code", "role", "assignment"]
    },
    "Group": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Group",
      "type": "object",
      "description": "Represents a group or center of members.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the Group entity." },
        "name": { "type": "string", "description": "Name of the group." },
        "branchId": { "type": "string", "description": "Reference to Branch. (Relationship: Branch 1:N Group)" }
      },
      "required": ["id", "name", "branchId"]
    },
    "GroupMemberChange": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GroupMemberChange",
      "type": "object",
      "description": "Represents a record of members added or dropped from a group on a specific date.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the transaction." },
        "date": { "type": "string", "format": "date", "description": "The date of the change." },
        "groupId": { "type": "string", "description": "The ID of the affected group." },
        "branchId": { "type": "string", "description": "The ID of the group's branch, for easier querying." },
        "added": { "type": "number", "description": "Number of members added." },
        "dropped": { "type": "number", "description": "Number of members dropped." },
        "notes": { "type": "string", "description": "Optional notes." }
      },
      "required": ["id", "date", "groupId", "branchId", "added", "dropped"]
    },
    "SavingsTransaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SavingsTransaction",
      "type": "object",
      "description": "Represents a savings deposit or withdrawal for a group.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the transaction." },
        "date": { "type": "string", "format": "date", "description": "The date of the transaction." },
        "groupId": { "type": "string", "description": "The ID of the affected group." },
        "branchId": { "type": "string", "description": "The ID of the group's branch, for easier querying." },
        "deposit": { "type": "number", "description": "Amount deposited." },
        "withdraw": { "type": "number", "description": "Amount withdrawn." },
        "notes": { "type": "string", "description": "Optional notes." }
      },
      "required": ["id", "date", "groupId", "branchId", "deposit", "withdraw"]
    },
    "LoanDisbursement": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LoanDisbursement",
      "type": "object",
      "description": "Represents a loan amount given to a group.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the transaction." },
        "date": { "type": "string", "format": "date", "description": "The date of the disbursement." },
        "groupId": { "type": "string", "description": "The ID of the affected group." },
        "branchId": { "type": "string", "description": "The ID of the group's branch, for easier querying." },
        "amount": { "type": "number", "description": "Amount disbursed." },
        "notes": { "type": "string", "description": "Optional notes." }
      },
      "required": ["id", "date", "groupId", "branchId", "amount"]
    },
    "LoanCollection": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LoanCollection",
      "type": "object",
      "description": "Represents a loan repayment collected from a group.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the transaction." },
        "date": { "type": "string", "format": "date", "description": "The date of the collection." },
        "groupId": { "type": "string", "description": "The ID of the affected group." },
        "branchId": { "type": "string", "description": "The ID of the group's branch, for easier querying." },
        "amount": { "type": "number", "description": "Amount collected." },
        "notes": { "type": "string", "description": "Optional notes." }
      },
      "required": ["id", "date", "groupId", "branchId", "amount"]
    },
    "OtherDataEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "OtherDataEntry",
      "type": "object",
      "description": "Represents miscellaneous financial data for a branch on a given day.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the entry." },
        "date": { "type": "string", "format": "date", "description": "The date of the entry." },
        "branchId": { "type": "string", "description": "The ID of the branch." },
        "branch": { "type": "string", "description": "The name of the branch (for display)." },
        "type": { "type": "string", "enum": ["Others Expenses", "Cash", "Bank", "Afternoon Collection", "Today Total Cash", "Risk Fund", "Processing Fee", "Passbook Fee", "Admission Fee"] },
        "amount": { "type": "number", "description": "The financial amount." },
        "notes": { "type": "string", "description": "Optional notes." }
      },
      "required": ["id", "date", "branchId", "branch", "type", "amount"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      { "path": "/regions/{regionId}", "definition": { "entityName": "Region", "schema": { "$ref": "#/entities/Region" }, "description": "Stores region data." } },
      { "path": "/regions/{regionId}/zones/{zoneId}", "definition": { "entityName": "Zone", "schema": { "$ref": "#/entities/Zone" }, "description": "Stores zone data within a region." } },
      { "path": "/regions/{regionId}/zones/{zoneId}/areas/{areaId}", "definition": { "entityName": "Area", "schema": { "$ref": "#/entities/Area" }, "description": "Stores area data within a zone." } },
      { "path": "/regions/{regionId}/zones/{zoneId}/areas/{areaId}/branches/{branchId}", "definition": { "entityName": "Branch", "schema": { "$ref": "#/entities/Branch" }, "description": "Stores branch data within an area." } },
      { "path": "/regions/{regionId}/zones/{zoneId}/areas/{areaId}/branches/{branchId}/groups/{groupId}", "definition": { "entityName": "Group", "schema": { "$ref": "#/entities/Group" }, "description": "Stores group data within a branch." } },
      { "path": "/employees/{employeeId}", "definition": { "entityName": "Employee", "schema": { "$ref": "#/entities/Employee" }, "description": "Stores employee data." } },
      { "path": "/member_changes/{changeId}", "definition": { "entityName": "GroupMemberChange", "schema": { "$ref": "#/entities/GroupMemberChange" }, "description": "Stores daily member changes for all groups." } },
      { "path": "/savings_transactions/{txId}", "definition": { "entityName": "SavingsTransaction", "schema": { "$ref": "#/entities/SavingsTransaction" }, "description": "Stores daily savings transactions for all groups." } },
      { "path": "/loan_disbursements/{disbursementId}", "definition": { "entityName": "LoanDisbursement", "schema": { "$ref": "#/entities/LoanDisbursement" }, "description": "Stores loan disbursement records." } },
      { "path": "/loan_collections/{collectionId}", "definition": { "entityName": "LoanCollection", "schema": { "$ref": "#/entities/LoanCollection" }, "description": "Stores loan collection records." } },
      { "path": "/others_data/{otherDataId}", "definition": { "entityName": "OtherDataEntry", "schema": { "$ref": "#/entities/OtherDataEntry" }, "description": "Stores other miscellaneous daily data for all branches." } }
    ]
  }
}
