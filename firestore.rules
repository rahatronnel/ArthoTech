rules_version = '2';

/**
 * @name LendEasy Microfinance Security Rules
 * @description This ruleset provides granular access control. It includes a temporary
 *              public read rule on the 'employees' collection to allow an initial
 *              Super Admin setup if no admin account exists.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description More specific rule for the employees collection.
     *              Allows public reads to check for a Super Admin during initial setup.
     *              Writes are still protected and require authentication.
     */
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    /**
     * @description Default rule for all other documents.
     *              This rule does not apply to the employees collection because the
     *              rule above is more specific. It requires authentication for all
     *              reads and writes.
     */
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
