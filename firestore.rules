rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Function to get the role of the currently signed-in user
    function getUserRole() {
      // Access the user's profile document using their UID
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role;
    }

    // Function to check if the user is a Super Admin
    function isSuperAdmin() {
      // Only allow if signed in, and their role is 'Super Admin'
      return isSignedIn() && getUserRole() == 'Super Admin';
    }

    // By default, only a Super Admin can read or write any document.
    // This provides a secure default while ensuring the admin has full control.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
