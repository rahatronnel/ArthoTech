rules_version = '2';

/**
 * @name LendEasy Microfinance Security Rules - Unrestricted Authenticated Access
 * @author Firebase Security Rules Architect
 *
 * @description
 * This ruleset grants full read and write access to the entire Firestore database
 * for any user who is successfully authenticated. It simplifies the security model
 * to a single check: `isSignedIn()`.
 *
 * This approach is suitable for internal applications where all authenticated users
 * are trusted, or for early-stage development and prototyping.
 *
 * Core Principle:
 * - If a user is signed in, they can do anything.
 * - If a user is not signed in, they can do nothing.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Matches every document in the database.
     * @allow       (read, write) Any authenticated user.
     * @deny        Any unauthenticated user.
     * @principle   Provides unrestricted access for all signed-in users.
     */
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
