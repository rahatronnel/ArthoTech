rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requesting user has the 'Super Admin' role.
    function isSuperAdmin() {
      // Safely check for the existence of the user's document before accessing its data.
      return request.auth != null &&
             exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'Super Admin';
    }

    // Rule for the 'employees' collection.
    match /employees/{userId} {
      // Any authenticated user can read their OWN employee document. 
      // This is the key to breaking the circular dependency of role-based rules.
      allow get: if request.auth != null && request.auth.uid == userId;
      
      // A Super Admin can list, create, update, and delete any employee document.
      allow list, write: if isSuperAdmin();
    }

    // Generic rule for ALL OTHER collections in the database.
    match /{path=**} {
      // Only a Super Admin can read or write to any other collection.
      allow read, write: if isSuperAdmin();
    }
  }
}
