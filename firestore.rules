rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      // This `get` is safe because of the specific `allow read` rule on /employees/{userId}
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      // Check for document existence before getting data to prevent errors
      return isSignedIn() &&
             exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
             getUserRole() == 'Super Admin';
    }

    // --- Rules ---

    // Employees Collection: This specific rule is evaluated before the general one below.
    // It breaks the recursive permission dependency for role checks.
    match /employees/{userId} {
      // A user can read their own profile, OR if the requester is a Super Admin.
      allow read: if (isSignedIn() && request.auth.uid == userId) || isSuperAdmin();
      // Only a Super Admin can write to employee profiles.
      allow write: if isSuperAdmin();
    }

    // General Rule for All Other Documents.
    // This will be OR'd with the rule above for the employees collection, which is fine.
    // For all other collections, this is the only rule that applies.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
